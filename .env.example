# Local PostgreSQL (already used by the starter)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public site URL — used for canonical tags, sitemap, and share links
NEXT_PUBLIC_SITE_URL=https://gigworkerfinance.vercel.app

# Google Analytics 4 measurement ID (example: G-XXXXXXXXXX)
# Leave empty until you are ready. The root layout injects gtag only when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense publisher ID (example: ca-pub-xxxxxxxxxxxxxxxx)
# Leave empty until approved. The root layout adds the verification meta tag and adsbygoogle script when set.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
